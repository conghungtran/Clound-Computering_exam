<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <style>
    body { font-family: Arial, sans-serif; max-width: 900px; margin: 30px auto; padding: 0 16px; }
    input, button { padding: 6px 10px; margin: 2px; }
    table { border-collapse: collapse; width: 100%; margin-top: 16px; }
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; }
    th { background: #f3f3f3; }
    .error { color: #c00; font-weight: bold; }
    footer { margin-top: 40px; color: #555; font-size: 14px; }
  </style>
</head>
<body>
  {{{body}}}
  <footer>
    <hr>
    <p>{{fullName}} - MSSV: {{mssv}} - VAT áp dụng: {{vat}}%</p>
  </footer>
</body>
</html>
