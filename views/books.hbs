<h1>Quản lý Sách</h1>
{{#if error}}<p class="error">{{error}}</p>{{/if}}

<form method="POST" action="/books">
  <input name="code" placeholder="Mã sách (bắt đầu bằng {{prefix}})" required>
  <input name="title" placeholder="Tên sách" required>
  <input name="price" type="number" step="any" min="0" placeholder="Giá gốc" required>
  <button type="submit">Thêm</button>
</form>

<table>
  <tr><th>Mã</th><th>Tên sách</th><th>Giá gốc</th><th>VAT</th><th>Giá sau thuế</th></tr>
  {{#each books}}
  <tr>
    <td>{{code}}</td>
    <td>{{title}}</td>
    <td>{{price}}</td>
    <td>{{vat}}%</td>
    <td>{{priceAfterVat}}</td>
  </tr>
  {{else}}
  <tr><td colspan="5">Chưa có sách nào.</td></tr>
  {{/each}}
</table>
